---
import BaseLayout from "../components/BaseLayout.astro";
---

<BaseLayout
  title="Writing — Erik Fryscok"
  description="Articles by Erik Fryscok on AI-assisted software engineering, agent evaluations, local and cloud model systems, developer tooling, and engineering leadership."
>
  <div class="max-w-2xl mx-auto">
    <h1 class="text-3xl font-bold mb-6">Writing</h1>

    <p class="text-gray-700 mb-8 leading-relaxed">
      I write about AI-assisted software engineering, evaluations and reliability,
      local and cloud model systems, developer tooling, and the leadership practices
      that help teams adopt AI with appropriate judgment.
    </p>

    <div class="border border-gray-200 rounded-lg p-6">
      <h2 class="text-lg font-semibold mb-4">Articles</h2>
      <ul class="space-y-4">
        <li>
          <p class="text-sm text-gray-500 mb-1">Published: 2026-08-08</p>
          <a
            href="/writing/why-i-keep-coming-back-to-codex"
            class="text-blue-600 hover:text-blue-800 hover:underline font-medium transition-colors"
          >
            Why I Keep Coming Back to Codex
          </a>
          <p class="text-gray-600 mt-1">
            A week of customizing coding agents, building evaluations, weighing usage
            costs, and finding the workflow I want to keep using.
          </p>
        </li>
        <li>
          <p class="text-sm text-gray-500 mb-1">Published: 2026-08-01</p>
          <a
            href="/writing/opencode-configuration-guide"
            class="text-blue-600 hover:text-blue-800 hover:underline font-medium transition-colors"
          >
            OpenCode Configuration Guide: Safety, Quality, and ROI in AI-Assisted Delivery
          </a>
          <p class="text-gray-600 mt-1">
            A practical walkthrough of agent roles, permission design, and MCP controls
            that keep AI coding workflows effective and production-safe.
          </p>
        </li>
      </ul>
    </div>
  </div>
</BaseLayout>
