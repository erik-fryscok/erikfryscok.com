---
import BaseLayout from "../components/BaseLayout.astro";
---

<BaseLayout title="Writing — Erik Fryscok">
  <div class="max-w-2xl mx-auto">
    <h1 class="text-3xl font-bold mb-6">Writing</h1>

    <p class="text-gray-700 mb-8 leading-relaxed">
      Thoughts on engineering leadership, AI-enabled development, cloud
      infrastructure, documentation, and practical systems that help teams work
      more effectively. The goal is shared understanding — patterns, lessons,
      and architectures that others can build on.
    </p>

    <!-- Placeholder Article List -->
    <div class="border border-gray-200 rounded-lg p-6">
      <h2 class="text-lg font-semibold mb-3">Articles</h2>
      <p class="text-gray-500 italic">
        Articles are coming soon. This section will host Markdown-based writing
        on software engineering, team practices, and the tools that make modern
        development teams more effective.
      </p>
    </div>
  </div>
</BaseLayout>
