---
import BaseLayout from "../components/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";

interface ProjectLink {
  label: string;
  href: string;
  external: boolean;
}

interface Project {
  title: string;
  supportingLabel?: string;
  description: string;
  technologies: string[];
  outcomes: string[];
  links: ProjectLink[];
}

const projects: Project[] = [
  {
    title: "AI Systems Lab",
    supportingLabel: "EXPERIMENTAL",
    description:
      "An experimental learning and evaluation environment for AI model systems, exploring provider-neutral routing, model lifecycle, compatibility, benchmarks, and local llama.cpp and cloud-hosted OpenAI-compatible capability boundaries.",
    technologies: ["Python", "llama.cpp", "OpenAI-compatible APIs", "Hugging Face", "JSONL"],
    outcomes: [
      "Workload-specific model aliases across local llama.cpp and cloud-hosted OpenAI-compatible provider backends",
      "Compatibility gates for visible completions and structured tool calls",
      "Layered throughput, server-path, and quality evaluation workflows",
    ],
    links: [
      { label: "Read case study", href: "/projects/ai-systems-lab", external: false },
      { label: "Source", href: "https://github.com/erik-fryscok/ai-systems-lab", external: true },
    ],
  },
  {
    title: "Agent Skills",
    description:
      "An open-source collection of reusable, evidence-backed agent skills that turn practical engineering judgment into dependable software-development workflows.",
    technologies: ["Agent Skills", "Markdown", "YAML", "GitHub"],
    outcomes: [
      "Evidence-based GitHub public-readiness audits",
      "Workflow guidance, evaluation criteria, and reporting structure kept separate",
      "MIT-licensed foundation for future agent tooling",
    ],
    links: [
      { label: "Read case study", href: "/projects/agent-skills", external: false },
      { label: "Source", href: "https://github.com/erik-fryscok/skills", external: true },
    ],
  },
  {
    title: "erikfryscok.com",
    description:
      "A public engineering home base delivered as a fast, static site with a practical workflow for planning, previews, owned infrastructure, and domain email.",
    technologies: ["Astro", "TypeScript", "Tailwind CSS", "Cloudflare Pages", "GitHub", "Proton Mail"],
    outcomes: [
      "Static production site served without a server-side runtime",
      "Cloudflare-managed domain and DNS with Proton Mail domain email",
      "Public GitHub Issues and project board for delivery planning",
    ],
    links: [
      { label: "Read case study", href: "/projects/personal-website", external: false },
      { label: "Source", href: "https://github.com/erik-fryscok/erikfryscok.com", external: true },
    ],
  },
];
---

<BaseLayout
  title="Projects — Erik Fryscok"
  description="Selected AI and software engineering projects from Erik Fryscok, including the experimental AI Systems Lab, Agent Skills, and evidence-based developer tooling."
>
  <div class="max-w-4xl mx-auto">
    <h1 class="text-3xl font-bold mb-3">Projects</h1>
    <p class="text-gray-700 mb-10 max-w-2xl">
      Selected projects showing how I build, test, and reason about AI developer
      systems. AI Systems Lab is an experimental learning environment; Agent
      Skills is the more directly reusable developer workflow project.
    </p>

    <div class="grid grid-cols-1 gap-6">
      {projects.map((project) => (
        <ProjectCard
          title={project.title}
          supportingLabel={project.supportingLabel}
          description={project.description}
          technologies={project.technologies}
          outcomes={project.outcomes}
          links={project.links}
        />
      ))}
    </div>

    <p class="mt-8 text-sm text-gray-600 max-w-2xl">
      More selected work will appear here as it is ready to share publicly and
      can support useful, evidence-based lessons.
    </p>
  </div>
</BaseLayout>
