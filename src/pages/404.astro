---
import BaseLayout from "../components/BaseLayout.astro";
---

<BaseLayout
  title="Page Not Found — Erik Fryscok"
  description="The requested page could not be found on erikfryscok.com."
  indexable={false}
>
  <section class="max-w-2xl mx-auto">
    <p class="text-sm font-semibold uppercase tracking-wide text-blue-700 mb-3">404</p>
    <h1 class="text-3xl font-bold mb-4">Page not found</h1>
    <p class="text-gray-700 leading-relaxed mb-6">
      The page you requested does not exist or may have moved.
    </p>
    <div class="flex flex-wrap gap-4">
      <a href="/" class="text-blue-600 hover:text-blue-800 hover:underline font-medium">Home</a>
      <a href="/contact" class="text-blue-600 hover:text-blue-800 hover:underline font-medium">Contact</a>
    </div>
  </section>
</BaseLayout>
