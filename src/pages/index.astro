---
import { Image } from "astro:assets";
import BaseLayout from "../components/BaseLayout.astro";
import portrait from "../assets/erik-fryscok-portrait.jpg";
---

<BaseLayout
  title="Erik Fryscok — Practical AI Systems for Software Development"
  description="Erik Fryscok builds and evaluates AI systems for software development, including coding-agent workflows, local-model experiments, evaluations, and developer tooling."
>
  <!-- Hero Section -->
  <section class="mb-16 grid gap-8 md:grid-cols-[minmax(0,1fr)_16rem] md:items-center md:gap-10">
    <div>
      <h1 class="text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl">
        Building practical AI systems for software development.
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-gray-600 max-w-3xl">
        I’m a software development team lead and hands-on engineer working with coding
        agents, local and open-weight models, developer tooling, evaluations, cloud
        infrastructure, and the systems that help engineering teams ship better software.
      </p>
    </div>
    <Image
      src={portrait}
      alt="Erik Fryscok smiling outdoors with a city street in the background."
      width={512}
      height={512}
      format="webp"
      quality={80}
      loading="eager"
      fetchpriority="high"
      class="mx-auto aspect-square w-full max-w-64 rounded-2xl object-cover shadow-sm md:mx-0"
    />
  </section>

  <!-- Introduction Section -->
  <section class="mb-16">
    <h2 class="text-2xl font-semibold text-gray-900 mb-4">What I work on</h2>
    <p class="text-gray-700 leading-relaxed max-w-3xl">
      I build and evaluate the systems around AI-assisted software development:
      agent workflows, developer tooling, model experiments, and the guardrails
      that make them useful in real teams. My leadership experience shapes the
      work—clear evidence, honest capability boundaries, maintainable systems,
      and better engineering outcomes over novelty.
    </p>
    <a
      href="/about"
      class="inline-block mt-4 text-blue-600 hover:text-blue-800 hover:underline transition-colors font-medium"
    >
      Learn more about my background &rarr;
    </a>
  </section>

  <!-- Selected Work Section -->
  <section class="mb-16">
    <h2 class="text-2xl font-semibold text-gray-900 mb-6">Selected Work</h2>
    <div class="grid gap-6 sm:grid-cols-2">
      <!-- Local AI Lab Card -->
      <a
        href="/projects/local-ai-lab"
        class="group block rounded-lg border border-blue-200 bg-blue-50 p-6 transition-all hover:border-blue-400 hover:shadow-md sm:col-span-2"
      >
        <p class="text-sm font-semibold uppercase tracking-wide text-blue-700">
          Experimental AI lab
        </p>
        <h3 class="text-lg font-semibold text-gray-900 group-hover:text-blue-600 transition-colors">
          Local AI Lab
        </h3>
        <p class="mt-2 text-gray-600">
          A learning and evaluation environment for local and open-weight models,
          exploring routing, compatibility, benchmarks, and when frontier cloud
          models remain the better choice.
        </p>
        <span class="inline-block mt-4 text-blue-600 group-hover:text-blue-800 transition-colors">
          Explore the lab &rarr;
        </span>
      </a>

      <!-- Agent Skills Card -->
      <a
        href="/projects/agent-skills"
        class="group block border border-gray-200 rounded-lg p-6 hover:border-gray-400 hover:shadow-md transition-all"
      >
        <h3 class="text-lg font-semibold text-gray-900 group-hover:text-blue-600 transition-colors">
          Agent Skills
        </h3>
        <p class="mt-2 text-gray-600">
          Reusable, evidence-backed workflows that turn practical engineering
          judgment into dependable instructions for AI coding agents.
        </p>
        <span class="inline-block mt-4 text-blue-600 group-hover:text-blue-800 transition-colors">
          Read the case study &rarr;
        </span>
      </a>

      <!-- Codex Article Card -->
      <a
        href="/writing/why-i-keep-coming-back-to-codex"
        class="group block border border-gray-200 rounded-lg p-6 hover:border-gray-400 hover:shadow-md transition-all"
      >
        <h3 class="text-lg font-semibold text-gray-900 group-hover:text-blue-600 transition-colors">
          Why I Keep Coming Back to Codex
        </h3>
        <p class="mt-2 text-gray-600">
          What customizing coding agents, building evaluations, weighing usage costs,
          and testing workflow continuity taught me.
        </p>
        <span class="inline-block mt-4 text-blue-600 group-hover:text-blue-800 transition-colors">
          Read the article &rarr;
        </span>
      </a>
    </div>
  </section>

  <!-- Contact CTA Section -->
  <section class="mb-8">
    <div class="border border-gray-200 rounded-lg p-8 bg-gray-50">
      <h2 class="text-2xl font-semibold text-gray-900 mb-3">Opportunities and collaboration</h2>
      <p class="text-gray-700 mb-6 max-w-2xl">
        I’m interested in hands-on AI/software engineering roles, engineering
        leadership opportunities, and collaborations around agents, evaluations,
        model selection, and developer tooling.
      </p>
      <a
        href="/contact"
        class="inline-block bg-blue-600 text-white font-medium px-6 py-3 rounded-lg hover:bg-blue-700 transition-colors"
      >
        Get in Touch
      </a>
    </div>
  </section>
</BaseLayout>
