{
  "$schema": "https://opencode.ai/config.json",

  // Safe starting point. Explicitly switch to Build when implementation begins.
  "default_agent": "chat",

  "enabled_providers": ["anthropic", "openai", "opencode", "cline-pass", "lmstudio"],
  "provider": {
    "lmstudio": {
      "models": {
        "qwen/qwen3.5-9b": {
          "name": "Qwen3.5 9B"
        },
        "openai/gpt-oss-120b": {
          "name": "GPT-OSS 120B"
        },
        "qwen/qwen3.6-35b-a3b": {
          "name": "Qwen3.6 35B A3B"
        },
        "qwen/qwen3.5 122B A10B": {
          "name": "Qwen3.5 122B A10B"
        },
        "openai/gpt-oss-20b": {
          "name": "GPT-OSS 20B"
        }
      }
    }
  },

  // Prevent subagents from recursively spawning more subagents.
  "subagent_depth": 1,

  "mcp": {
    /*
     * Remote-only GitHub information:
     * issues, PRs, reviews, comments, and statuses.
     *
     * Use a separate read-only fine-grained PAT restricted to the
     * repositories where this access is required.
     */
    "github_read": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_MCP_TOKEN}",

        // Exact tool allowlist rather than broad toolsets.
        "X-MCP-Tools": "get_me,issue_read,list_issues,search_issues,pull_request_read,list_pull_requests,search_pull_requests",

        // Additional protection against accidentally added write tools.
        "X-MCP-Readonly": "true"
      }
    },

    /*
     * Deliberately small publishing interface.
     *
     * Start with comments and draft PR creation. Add other write tools
     * only after a demonstrated need.
     */
    "github_publish": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_MCP_TOKEN}",
        "X-MCP-Tools": "add_issue_comment,create_pull_request"
      }
    }
  },

  /*
   * Keep the MCP servers connected, but hide their tools from all agents
   * unless an agent explicitly re-enables them.
   *
   * Do not use enabled:false here. That disables the entire server rather
   * than making it selectively available to agents.
   */
  "permission": {
    "github_*": "deny"
  },

  /*
   * Behavior configuration only: temperature, steps, permissions, and
   * task-delegation rules. Identity (description, model, mode, prompt)
   * lives in .opencode/agents/<name>.md — one source of truth per agent.
   */
  "agent": {
    "chat": {
      "temperature": 0.3,
      "color": "primary",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "edit": "deny",
        "bash": "deny",
        "task": "deny"
      }
    },

    "plan": {
      "temperature": 0.1,
      "color": "secondary",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "github_*": "deny",

        "task": {
          "*": "deny",

          // Fast local read-only exploration.
          "explore": "allow",

          // These can add cost, so require approval before delegation.
          "scout": "ask",
          "github-read": "ask",
          "general": "ask",

          // Review subagents are exclusive to Review.
          "documentation": "deny",
          "security": "deny",
          "code-review": "deny",

          // Publication must never happen through automatic delegation.
          "github-publish": "deny"
        }
      }
    },

    "build": {
      "temperature": 0.2,
      "color": "accent",
      "permission": {
        "edit": "allow",

        // Build works locally and delegates remote reads when necessary.
        "github_*": "deny",

        "task": {
          "*": "deny",
          "explore": "allow",
          "scout": "ask",
          "github-read": "ask",
          "general": "ask",

          // Review subagents are exclusive to Review.
          "documentation": "deny",
          "security": "deny",
          "code-review": "deny",

          "github-publish": "deny"
        },

        /*
         * Allow harmless inspection commands.
         * Ask before local state changes.
         * Deny high-risk/destructive operations.
         *
         * Rules are evaluated in order; the last matching rule wins.
         */
        "bash": {
          "*": "ask",

          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git rev-parse*": "allow",
          "git ls-files*": "allow",

          "git commit*": "ask",
          "git push*": "ask",

          "git push *--force*": "deny",
          "git reset --hard*": "deny",
          "git clean*": "deny",
          "git branch -D*": "deny",

          /*
           * Prevent GitHub CLI from silently bypassing your MCP rules.
           * Specific read-only gh commands can be allowed later.
           */
          "gh *": "ask",
          "gh pr merge*": "deny",
          "gh repo delete*": "deny",

          "npm run check": "allow",
          "ls -la*": "allow",
          "git check*": "allow",
          "git worktree *": "allow"
        }
      }
    },

    /*
     * Review orchestrates its three specialist subagents and synthesizes
     * their findings. Read-only itself; generous steps for the
     * gather → delegate → synthesize cycle.
     */
    "review": {
      "temperature": 0,
      "color": "info",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "edit": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "github_*": "deny",

        "task": {
          "*": "deny",

          // The three specialists this orchestrator drives.
          "code-review": "allow",
          "security": "allow",
          "documentation": "allow",

          // Local exploration when subagent findings need verification.
          "explore": "allow",

          // External lookups require approval.
          "scout": "ask",
          "github-read": "ask",

          "general": "deny",
          "github-publish": "deny"
        },

        /*
         * Read-only git inspection for assembling the branch diff.
         * All state-changing git operations are denied outright.
         */
        "bash": {
          "*": "ask",

          "git status*": "allow",
          "git rev-parse*": "allow",
          "git merge-base*": "allow",
          "git log*": "allow",
          "git diff*": "allow",
          "git show*": "allow",
          "git blame*": "allow",
          "git branch": "allow",
          "git branch -a*": "allow",
          "git branch -r*": "allow",
          "git branch -vv*": "allow",
          "git ls-files*": "allow",
          "git name-rev*": "allow",
          "git remote": "allow",
          "git remote -v*": "allow",
          "git config --get*": "allow",
          "git stash list*": "allow",

          "git commit*": "deny",
          "git push*": "deny",
          "git reset*": "deny",
          "git rebase*": "deny",
          "git merge*": "deny",
          "git checkout*": "deny",
          "git switch*": "deny",
          "git cherry-pick*": "deny",
          "git revert*": "deny",
          "git branch -d*": "deny",
          "git branch -D*": "deny",
          "git stash drop*": "deny",
          "git stash pop*": "deny"
        }
      }
    },

    /*
     * Re-enabled general-purpose worker. Cheapest capable model assigned
     * in its markdown file; edit access retained for multi-step work.
     */
    "general": {
      "temperature": 0.3,
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "edit": "allow",
        "bash": "ask",
        "github_*": "deny",
        "task": "deny"
      }
    },

    "explore": {
      "temperature": 0,
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "edit": "deny",
        "bash": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "task": "deny"
      }
    },

    "scout": {
      "temperature": 0,
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "edit": "deny",
        "bash": "deny",
        "task": "deny"
      }
    },

    /*
     * Review's three specialists. Read-only, focused, and denied any
     * further delegation (subagent_depth is 1, but belt and braces).
     */
    "documentation": {
      "temperature": 0,
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "edit": "deny",
        "bash": "deny",
        "webfetch": "allow",
        "websearch": "allow",
        "github_*": "deny",
        "task": "deny"
      }
    },

    "security": {
      "temperature": 0,
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "edit": "deny",
        "bash": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "github_*": "deny",
        "task": "deny"
      }
    },

    "code-review": {
      "temperature": 0,
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "edit": "deny",
        "bash": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "github_*": "deny",
        "task": "deny"
      }
    },

    "github-read": {
      "temperature": 0,

      "permission": {
        "edit": "deny",
        "bash": "deny",
        "read": "deny",
        "glob": "deny",
        "grep": "deny",
        "lsp": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "task": "deny",

        "github_read_*": "allow",
        "github_publish_*": "deny"
      }
    },

    "github-publish": {
      "temperature": 0,

      "permission": {
        "edit": "deny",
        "bash": "deny",
        "read": "deny",
        "glob": "deny",
        "grep": "deny",
        "lsp": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "task": "deny",

        // Read before publishing when necessary.
        "github_read_*": "allow",

        // Every advertised publishing operation requires approval.
        "github_publish_*": "ask"
      }
    }
  }
}
